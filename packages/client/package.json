{
  "name": "@reconsumet/client",
  "version": "0.6.0",
  "description": "Typed client for a RECONSUMΣT.TS API server (Hono RPC)",
  "license": "GPL-3.0-or-later",
  "author": "thesupersupersigma",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
