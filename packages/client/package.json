    "vitest": "^5.1.1"
  },
  "keywords": [
    "anime",
    "api-client",
    "hono",
    "typed",
    "consumet",
    "anilist"
  ],
  "homepage": "https://github.com/thesupersupersigma/RECONSUMET.TS/tree/master/packages/client#readme",
  "bugs": {
    "url": "https://github.com/thesupersupersigma/RECONSUMET.TS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesupersupersigma/RECONSUMET.TS.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  }
