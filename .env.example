# RECONSUMΣT.TS settings. `cp .env.example .env`, then fill in the two REQUIRED values. Never commit .env.
# Everything else is optional: an empty value means the default shown. Full guide: docs/self-hosting.md.
# Generate secrets with: openssl rand -base64 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")

# ---------------------------------------------------------------- required
# Password of the bundled Postgres (compose builds DATABASE_URL from it). Any long random string.
POSTGRES_PASSWORD=
# Shared by API and relay: the key that seals stream links. At least 32 characters.
RELAY_SECRET=

# ---------------------------------------------------------------- docker compose
# Where the API and relay ports are published. Default 127.0.0.1 (this machine only, e.g. behind a reverse proxy
# on the host or the caddy profile). 0.0.0.0 = reachable from the network.
BIND_ADDR=
# Host ports. Defaults 8080 (API) and 8081 (relay).
API_PORT=
RELAY_PORT=
# Image tag when using prebuilt images (`docker compose pull`). Default latest. Example: 0.4.1
RECONSUMET_VERSION=
# caddy profile only (`docker compose --profile caddy up -d`): the public names Caddy gets certificates for.
# Example: api.example.com and relay.example.com (DNS must point at this machine, ports 80 + 443 open).
API_DOMAIN=
RELAY_DOMAIN=

# ---------------------------------------------------------------- running without Docker (pnpm dev)
# Compose sets this itself. Only for `pnpm dev`: postgres://user:password@localhost:5432/reconsumet
DATABASE_URL=

# ---------------------------------------------------------------- api + relay
# Reverse proxies whose client-IP header is believed (IPs/CIDRs, comma-separated). Default empty: nobody's.
# Behind the caddy profile or another proxy in the same compose network: 172.16.0.0/12 (Docker's private range).
# Behind a proxy on the host: its address as the containers see it (usually 172.16.0.0/12 too).
TRUSTED_PROXIES=
# Header that carries the viewer's IP, read only from TRUSTED_PROXIES. Default X-Forwarded-For.
# Examples: CF-Connecting-IP (Cloudflare), X-Real-IP (nginx).
CLIENT_IP_HEADER=

# ---------------------------------------------------------------- api
# Where the API is reachable from outside (shown in /openapi.json). Default http://localhost:8080.
# Example: https://api.example.com
PUBLIC_URL=
# Where browsers reach the relay; stream links are <this>/r/<token>. Default http://localhost:8081.
# Examples: https://relay.example.com, or https://example.com/relay (relay under a path, see the guide).
RELAY_PUBLIC_URL=
# How long a fresh stream link can be started, minutes. Default 10.
RELAY_TOKEN_TTL_MIN=
# false when the relay runs on another machine/IP than the API: IP-locked streams (Re:Anime HD-1) are dropped then.
# Default true.
RELAY_SHARES_EGRESS_WITH_API=
# The streams route needs an API key. Default true.
REQUIRE_KEY_FOR_STREAMS=
# Requests per minute per IP without a key / per key. Defaults 60 / 600.
RATE_LIMIT_IP_PER_MIN=
RATE_LIMIT_KEY_PER_MIN=
# Run the catalog / AniList / health / cache jobs in the API process. Default true.
JOBS_ENABLED=
# AniList requests per UTC day (cache hits don't count). Default 300.
RECONSUMET_ANILIST_DAILY_CAP=

# ---------------------------------------------------------------- relay
# Previous RELAY_SECRET, accepted while you rotate it. Default empty.
RELAY_SECRET_PREVIOUS=
# Site origins allowed to play from a browser, comma-separated. Default empty (only non-browser players).
# Example: https://example.com
RELAY_ALLOWED_ORIGINS=
# Bearer token for /metrics (Prometheus). Default empty = /metrics is off.
RELAY_METRICS_TOKEN=
# Parallel downloads per viewer IP. Default 6.
RELAY_MAX_STREAMS_PER_IP=
# Bandwidth ceiling per viewer IP, Mbit/s. Default 12 (about twice a 1080p stream).
RELAY_IP_MBPS=
# Bandwidth ceiling for all viewers together, Mbit/s. Default off. Set it a bit under your upload speed,
# e.g. 32 on a 40 Mbit/s upload (docs/self-hosting.md, "Sizing bandwidth").
RELAY_GLOBAL_MBPS=
# Lifetime of the segment links minted while rewriting a playlist, minutes. Default 360.
RELAY_CHILD_TTL_MIN=
# Longer playlists are refused. Default 20000.
RELAY_MAX_PLAYLIST_LINES=
# Biggest segment relayed, MiB. Default 64.
RELAY_MAX_SEGMENT_MB=
