# Copy to .env (never commit .env). Every variable is explained in docs/deploy.md.

# --- shared by api + relay ---
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELAY_SECRET=
# old secret during a rotation (relay only), else empty
RELAY_SECRET_PREVIOUS=
# reverse proxies whose X-Forwarded-For is believed (IPs/CIDRs, comma-separated)
TRUSTED_PROXIES=172.16.0.0/12

# --- api ---
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:8080
RELAY_PUBLIC_URL=http://localhost:8081
RELAY_TOKEN_TTL_MIN=10
RELAY_SHARES_EGRESS_WITH_API=true
REQUIRE_KEY_FOR_STREAMS=true
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_KEY_PER_MIN=600
JOBS_ENABLED=true
RECONSUMET_ANILIST_DAILY_CAP=300

# --- relay ---
RELAY_ALLOWED_ORIGINS=http://localhost:3000
RELAY_METRICS_TOKEN=
RELAY_MAX_STREAMS_PER_IP=6
RELAY_IP_MBPS=12
RELAY_GLOBAL_MBPS=32
RELAY_CHILD_TTL_MIN=360
